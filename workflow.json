      "name": "Sticky Note2"
    },
    {
      "parameters": {
        "content": "Krok 3: Weryfikacja Obecności w CRM (Search records - Airtable)\nFunkcja: Przeszukuje tabelę CRM w poszukiwaniu istniejącego rekordu z tym samym adresem e-mail ({Email} = 'podany_email').",
        "height": 336,
        "width": 272,
        "color": "#41B5D2"
