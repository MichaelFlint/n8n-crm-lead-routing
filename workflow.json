      "name": "Sticky Note1"
    },
    {
      "parameters": {
        "content": "### Step 2: Pre-cleaning (JavaScript Code Node)\n* **Function:** Standardizes raw incoming data prior to CRM lookup.\n* **Logic:** Trims whitespace (`trim()`), converts email to lowercase, and prepares sanitized search variables for deduplication.\n",
        "height": 224,
        "width": 272,
        "color": "#CD9418"
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
