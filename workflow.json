      "id": "10e3f8a3-662f-48ff-83ea-704b2d4e0526",
      "name": "Sticky Note2"
    },
    {
      "parameters": {
        "content": "### Step 3: CRM Lookup (Airtable Search)\n* **Function:** Queries Airtable CRM table to locate existing records matching the email address (`{Email} = 'submitted_email'`).\n\n",
        "height": 176,
        "width": 272,
        "color": "#338E94"
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -2800,
        -224
