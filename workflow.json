    {
      "parameters": {
        "jsCode": "let parsedAi = {};\nlet rawTextFromAI = \"\";\nlet parsingError = false;\n\ntry {\n  // 1. Bezpieczny odczyt tekstu z odpowiedzi OpenAI\n  rawTextFromAI = $json.output?.[0]?.content?.[0]?.text || \"\";\n  \n  // 2. Czyszczenie ze znaczników markdown\n  const cleanedText = rawTextFromAI.replace(/```json/g, '').replace(/```/g, '').trim();\n  \n  // 3. Próba parsowania do obiektu JSON\n  parsedAi = JSON.parse(cleanedText);\n} catch (error) {\n  // 4. FALLBACK: Jeśli JSON był uszkodzony, nie przerywamy pracy n8n\n  parsingError = true;\n  parsedAi = {\n    score: 0,\n    intent: \"UNKNOWN\",\n    budget_fit: \"UNKNOWN\",\n    summary: \"BŁĄD AI: Odpowiedź modelu nie zawierała poprawnego formatu JSON.\",\n    reasoning: `Nie udało się sparsować odpowiedzi z OpenAI. Błąd: ${error.message}`\n  };\n}\n\n// Bezpieczne pobranie danych leada z węzła \"Normalizacja\"\nconst leadData = $node[\"Normalizacja\"]?.json || {};\n\nreturn {\n  json: {\n    // Dane leada\n    full_name: leadData.full_name || \"\",\n    email: leadData.clean_email || \"\",\n    company: leadData.company || \"\",\n    budget: leadData.budget || \"\",\n    message: leadData.message || \"\",\n    \n    // Dane z AI (lub wartości awaryjne)\n    ai_score: typeof parsedAi.score === 'number' ? parsedAi.score : 0,\n    ai_intent: parsedAi.intent || \"UNKNOWN\",\n    ai_budget_fit: parsedAi.budget_fit || \"UNKNOWN\",\n    ai_summary: parsedAi.summary || \"\",\n    ai_reasoning: parsedAi.reasoning || \"\",\n    \n    // Flaga informująca, czy wystąpił awaryjny fallback\n    is_parsing_error: parsingError\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2064,
        96
      ],
      "id": "e686e2c2-789f-43cc-aaca-861c78e050d0",
